# ==================================================================
# NAMUNA FAYL — bu yerga HAQIQIY sir yozilmaydi.
# Nusxa oling: `cp .env.example .env` va qiymatlarni o'zingiznikiga
# almashtiring. `.env` `.gitignore` da — u hech qachon commit bo'lmaydi.
# ==================================================================

# ------------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL) — MAJBURIY
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacher_crm?schema=public"

# ------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET ni generatsiya qilish: `npx auth secret`
#   yoki: `openssl rand -base64 32`
#
# DIQQAT: o'zgaruvchilar nomi `AUTH_` bilan boshlanadi (v5 uslubi).
# `NEXTAUTH_SECRET` / `NEXTAUTH_URL` — eski v4 nomlari, kod ularni O'QIMAYDI.
# Kamida 32 belgi bo'lishi shart, aks holda ilova ishga tushmaydi.
# ------------------------------------------------------------------
AUTH_SECRET="bu-yerga-tasodifiy-maxfiy-kalit-qoying"

# Ilovaning tashqi manzili.
#
# ISHLAB CHIQARISHDA MAJBURIY (`src/lib/env.ts` tekshiradi) va `https://`
# bo'lishi shart. Sababi: bu qiymat bo'lmasa Auth.js qaytish havolalarini
# so'rovdagi `Host` sarlavhasidan oladi. Hujumchi soxta `Host` yuborib
# foydalanuvchini o'z domeniga yo'naltirishi mumkin (host header injection
# -> fishing -> sessiya o'g'irlash).
#
# Lokal ishlashda ham qo'yib qo'ying — `npm start` bilan sinaganda
# NODE_ENV=production bo'ladi va tekshiruv ishga tushadi.
AUTH_URL="http://localhost:3000"

# Auth.js `Host` sarlavhasiga ishonishi (self-hosted rejim).
# Kodda `trustHost: true` allaqachon qo'yilgan; bu o'zgaruvchi faqat
# hujjat va aniqlik uchun qabul qilinadi. Qiymat: "true" yoki "false".
# AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------
# SEED (demo ma'lumotlar) — FAQAT LOKAL BAZA UCHUN
# ------------------------------------------------------------------
# `npm run db:seed` shu parolni o'qiydi — kodga hardcode qilinmaydi.
# Parol siyosatidan o'tishi SHART (uzunlik + murakkablik), aks holda
# seed to'xtaydi. O'zingizniki bilan almashtiring.
SEED_PASSWORD="bu-yerga-kuchli-demo-parol-qoying"

# Seed masofaviy bazaga ishlashiga ruxsat: "0" (sukut) yoki "1".
#
# NIMA UCHUN QULF BOR: seed ma'lum parolli demo ADMIN hisobini yaratadi.
# U xato bazaga tushsa — tizimda to'liq huquqli orqa eshik paydo bo'ladi.
#
# Qulf mezoni muhit nomi EMAS, NISHON BAZA: `DATABASE_URL` hosti
# localhost / 127.0.0.1 / ::1 / host.docker.internal bo'lmasa, seed
# to'xtaydi. Sababi: `npm run db:seed` ni `tsx` ishga tushiradi va u
# NODE_ENV ni o'rnatmaydi — ya'ni faqat NODE_ENV ga tayanish ishlamaydi.
#
# Masofaviy bazaga seed qilish ATAYLAB qilinadigan qadam bo'lishi kerak.
# Bunday holda demo hisoblar `mustChangePassword: true` bilan yaratiladi.
# SEED_ALLOW_REMOTE="1"

# ------------------------------------------------------------------
# Vaqtinchalik o'lchov (0-to'lqin). Faqat lokal — prodda o'chirilgan.
# ------------------------------------------------------------------
# QUERY_LOG="1"          -> har Prisma so'rovi va davomiyligi logga chiqadi
# QUERY_LOG_MS="50"      -> "SEKIN" deb belgilash chegarasi (sukut: 100 ms)
# QUERY_LOG_PARAMS="1"   -> SQL parametrlari ham chiqadi.
#                           DIQQAT: parametrlarda parol hash'i, telefon,
#                           email kabi maxfiy qiymatlar bo'ladi. Faqat
#                           zarur bo'lganda yoqing va logni saqlamang.

# ------------------------------------------------------------------
# AI provayderi (KEYINCHALIK ulanadi — hozircha bo'sh qolsa ham bo'ladi)
# Kod provider-agnostic; kalit qo'yilganda AI modullari ishga tushadi.
# ------------------------------------------------------------------
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------
# SMS provayderi (10-bosqichda — Eskiz.uz / Play Mobile)
# ------------------------------------------------------------------
# ESKIZ_EMAIL=""
# ESKIZ_PASSWORD=""
