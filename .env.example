# ------------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL)
# Mahalliy ishlash uchun o'zingizning PostgreSQL ulanish satringizni qo'ying.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacher_crm?schema=public"

# ------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET ni generatsiya qilish: `npx auth secret` yoki `openssl rand -base64 32`
# ------------------------------------------------------------------
AUTH_SECRET="bu-yerga-tasodifiy-maxfiy-kalit-qoying"

# ------------------------------------------------------------------
# Demo seed paroli (faqat mahalliy). Productionda seed ishlamaydi.
# `npm run db:seed` shu qiymatni o'qiydi — kodga hardcode qilinmaydi.
# ------------------------------------------------------------------
SEED_PASSWORD="password123"

# ------------------------------------------------------------------
# AI provayderi (KEYINCHALIK ulanadi — hozircha bo'sh qolsa ham bo'ladi)
# Kod provider-agnostic; kalit qo'yilganda AI modullari ishga tushadi.
# ------------------------------------------------------------------
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------
# SMS provayderi (keyingi bosqichda — Eskiz.uz / Play Mobile)
# ------------------------------------------------------------------
# ESKIZ_EMAIL=""
# ESKIZ_PASSWORD=""
