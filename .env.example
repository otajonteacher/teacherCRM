# ------------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL)
# Mahalliy ishlash uchun o'zingizning PostgreSQL ulanish satringizni qo'ying.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacher_crm?schema=public"

# ------------------------------------------------------------------
# Auth.js (NextAuth v5)
# AUTH_SECRET ni generatsiya qilish: `npx auth secret` yoki `openssl rand -base64 32`
#
# DIQQAT: o'zgaruvchilar nomi `AUTH_` bilan boshlanadi (v5 uslubi).
# `NEXTAUTH_SECRET` / `NEXTAUTH_URL` — eski v4 nomlari, kod ularni O'QIMAYDI.
# ------------------------------------------------------------------
AUTH_SECRET="bu-yerga-tasodifiy-maxfiy-kalit-qoying"

# Ilovaning tashqi manzili. Ishlab chiqarishda MAJBURIY qo'yilishi kerak:
# u bo'lsa Auth.js qaytish havolalarini so'rovdagi `Host` sarlavhasidan emas,
# shu qiymatdan oladi — ya'ni soxta `Host` bilan hujum qilish imkoni yo'qoladi.
# Lokal ishlashda bo'sh qoldirsa ham bo'ladi.
# AUTH_URL="https://crm.maktab.uz"

# ------------------------------------------------------------------
# Demo seed paroli (faqat mahalliy). Productionda seed ishlamaydi.
# `npm run db:seed` shu qiymatni o'qiydi — kodga hardcode qilinmaydi.
# ------------------------------------------------------------------
SEED_PASSWORD="password123"

# ------------------------------------------------------------------
# Vaqtinchalik o'lchov (0-to'lqin). Faqat lokal, productionda ishlamaydi.
# QUERY_LOG=1        -> har Prisma so'rovi va davomiyligi logga chiqadi
# QUERY_LOG_MS=50    -> "SEKIN" deb belgilash chegarasi (sukut: 100 ms)
# QUERY_LOG_PARAMS=1 -> SQL parametrlari ham chiqadi (maxfiy ma'lumot!)
# ------------------------------------------------------------------
# QUERY_LOG="1"

# ------------------------------------------------------------------
# AI provayderi (KEYINCHALIK ulanadi — hozircha bo'sh qolsa ham bo'ladi)
# Kod provider-agnostic; kalit qo'yilganda AI modullari ishga tushadi.
# ------------------------------------------------------------------
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------
# SMS provayderi (keyingi bosqichda — Eskiz.uz / Play Mobile)
# ------------------------------------------------------------------
# ESKIZ_EMAIL=""
# ESKIZ_PASSWORD=""
